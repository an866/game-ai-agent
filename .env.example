# ===== OpenAI / LLM =====
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# ===== 外部 API Keys =====
RAWG_API_KEY=xxx
ITAD_API_KEY=xxx
STEAM_API_KEY=xxx
TAVILY_API_KEY=

# ===== MySQL 数据库 =====
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=game_agent

# ===== Redis =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ===== 调度器 =====
PRICE_CHECK_INTERVAL_HOURS=6
NEWS_FETCH_INTERVAL_HOURS=2
TIMEZONE=Asia/Shanghai

# ===== 对话记忆 =====
MEMORY_MAX_MESSAGES=20
MEMORY_COMPRESS_THRESHOLD=0.85
MEMORY_RECENT_KEEP=8

# ===== 日志 =====
LOG_LEVEL=INFO